# Not started by install_node_healing.sh - config.LoadNodes() itself
# refuses an empty registry ("is empty - nothing to watch"), and this
# repo's own nodes.example.json watches HYDRA-UMC-ORCHESTRATOR/
# VISION-NODE/COGNITIVE-NODE's HealthService gRPC endpoints, none of
# which run as real services on this CM5 yet (real, separate future
# work). Enable only once /etc/hydra-umc-node-healing/nodes.json has been
# created with at least one real, reachable node - see that install
# script's own printed instructions.
#
# This registry deliberately lives OUTSIDE the shared /etc/hydra-umc/
# tree (0750 root:hydra-umc-agent) - this service's own unprivileged
# account cannot traverse into that directory to open a config file
# itself (unlike an EnvironmentFile=, which systemd reads as root before
# dropping privileges) - real bug found live on this device's first
# install.
[Unit]
Description=HYDRA-UMC-NODE-HEALING real HydraNode watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hydra-umc-node-healing
Group=hydra-umc-node-healing
WorkingDirectory=/opt/hydra-umc/node-healing
ExecStart=/opt/hydra-umc/node-healing/hydra-umc-node-healing --nodes /etc/hydra-umc-node-healing/nodes.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
