# Not started by install_node_healing.sh - config.LoadNodes() itself
# refuses an empty registry ("is empty - nothing to watch"). Enable only once
# /etc/hydra-umc-node-healing/nodes.json has been created with at least
# one real, reachable node - see that install script's own printed
# instructions. An entry is probed over HTTP when it has a "healthUrl" (the
# services of this ecosystem speak HTTP; the ORCHESTRATOR is watched this way)
# and over the gRPC HealthService when it has an "address" (no service here
# implements that yet).
#
# --orchestrator-url points at the HYDRA-UMC-ORCHESTRATOR on this CM5
# (install_orchestrator.sh). Recovery (POST /nodes/:node/recover) is requested
# only for entries that carry a "dispatchNode", only after the node has stayed
# down for 15 s, never during the first 60 s after start-up, at most once per
# node every 5 minutes and 3 times per 10 minutes overall; the flags
# --recover-confirm-after, --startup-grace, --recover-cooldown and
# --recover-budget change those limits. The token (ORCHESTRATOR_TOKEN) comes
# from the EnvironmentFile below.
#
# --journal keeps an append-only, hash-chained JSON-lines record of every transition and recovery request in
# the state directory (5 rotated files of 5 MiB); check it with `hydra-umc-node-healing -journal PATH -journal-verify`.
#
# This registry deliberately lives OUTSIDE the shared /etc/hydra-umc/
# tree (0750 root:hydra-umc-agent) - this service's own unprivileged
# account cannot traverse into that directory to open a config file
# itself (unlike an EnvironmentFile=, which systemd reads as root before
# dropping privileges) - real bug found live on this device's first
# install.
[Unit]
Description=HYDRA-UMC-NODE-HEALING real HydraNode watchdog
After=network-online.target hydra-umc-orchestrator.service
Wants=network-online.target

[Service]
Type=simple
User=hydra-umc-node-healing
Group=hydra-umc-node-healing
WorkingDirectory=/opt/hydra-umc/node-healing
# ORCHESTRATOR_TOKEN (the orchestrator requires it once it has one) lives here, read by
# systemd as root before privileges are dropped; the file is optional
EnvironmentFile=-/etc/hydra-umc/orchestrator.env
ExecStart=/opt/hydra-umc/node-healing/hydra-umc-node-healing --nodes /etc/hydra-umc-node-healing/nodes.json --orchestrator-url http://127.0.0.1:8114 --journal /var/lib/hydra-umc-node-healing/journal.jsonl
StateDirectory=hydra-umc-node-healing
StateDirectoryMode=0750
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# A real, initial cgroup memory ceiling - conservative defaults, meant to be refined once real telemetry from this service running on the CM5 exists, never removed back to unlimited.
MemoryAccounting=yes
MemoryHigh=256M
MemoryMax=384M

[Install]
WantedBy=multi-user.target
