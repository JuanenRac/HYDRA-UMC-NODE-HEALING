# /etc/hydra-umc/node-healing/nodes.json starts as a real, honest empty
# registry ([]) - this repo's own nodes.example.json watches
# HYDRA-UMC-ORCHESTRATOR/VISION-NODE/COGNITIVE-NODE's HealthService gRPC
# endpoints, none of which run as real services on this CM5 yet (that's
# real, separate future work - see this session's own audit). Watching
# zero nodes is an honest starting state; add real entries as those nodes
# come online rather than shipping a registry that would only ever report
# every node unreachable.
[Unit]
Description=HYDRA-UMC-NODE-HEALING real HydraNode watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hydra-umc-node-healing
Group=hydra-umc-node-healing
WorkingDirectory=/opt/hydra-umc/node-healing
ExecStart=/opt/hydra-umc/node-healing/hydra-umc-node-healing --nodes /etc/hydra-umc/node-healing/nodes.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
